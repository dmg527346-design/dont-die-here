M.Order = game.HttpService:JSONDecode([==[["SpringyWhisk", "PoutingSugarBowl", "RockingSeahorseToy", "OrbitingAtomModel", "PeekingNestingDoll", "RestlessToyExcavator", "BobbingBirdBath", "CrinklyPaperBag", "SleepyMeasuringJug", "TopsyChessRook", "RestlessNutcracker", "SillySatelliteDish", "FidgetCalculator", "FoldingTravelStool", "TumblingDominoRack", "RebelliousToyDrum", "WindUpCrabToy", "OrigamiCrane", "DancingMetronome", "ColdIron", "GrumblingPiggyBank", "ForgetfulDeskLamp", "NervousSaltShaker", "CreepingTapeMeasure", "SulkingUmbrella", "BackwardsHairdryer", "NoseyMagnifier", "SqueakyDuck"]]==])
function M.Preview(id, player)
    assert(Run:IsStudio(), 'Item drafts can only be previewed in Studio')
    local entry = M.Items[id]
    assert(entry, 'Unknown draft id')
    player = player or Players:GetPlayers()[1]
    assert(player and player:GetAttribute('MissionActive') == true, 'Start a Studio mission first')
    local character = player.Character
    local root = character and character:FindFirstChild('HumanoidRootPart')
    assert(root and root:IsA('BasePart'), 'Mission character is not ready')
    local owner = game.ServerScriptService:FindFirstChild('CursedItemsServer')
    local preview = owner and owner:FindFirstChild('PreviewCursedBatch')
    assert(preview and preview:IsA('BindableFunction'), 'Mission item owner is not ready')
    local m = preview:Invoke(id, root.Position + root.CFrame.LookVector * 3 + Vector3.new(0, .5, 0))
    assert(m and m:GetAttribute('SelectedItem') == true, 'Draft preview was not registered')
    m:SetAttribute('Value', entry.value)
    m:SetAttribute('LootValue', entry.value)
    m:SetAttribute('DraftPreview', true)
    return m
end
return M
